def solve():
    N = int(input("Enter N: "))
    nums = list(map(int, input("Enter array elements: ").split()))

    count = 0

    for i in range(N):
        for j in range(i + 1, N):
            sum_i = sum(map(int, str(abs(nums[i]))))
            sum_j = sum(map(int, str(abs(nums[j]))))

            if sum_i == sum_j:
                count += 1

    return count


print("Labsheet 10")
answer = solve()
print("Output:", answer)
